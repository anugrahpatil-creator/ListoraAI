// Prisma schema for Business Listing Consistency Agent
// See ARCHITECTURE.md §4.6 for full model descriptions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model BusinessProfile {
  id           String   @id @default(uuid())
  name         String
  address      String
  phone        String   // stored as E.164
  regularHours Json
  holidayHours Json
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model Listing {
  id         String     @id @default(uuid())
  platform   String
  externalId String
  values     Json
  fetchedAt  DateTime
  createdAt  DateTime   @default(now())

  mismatches Mismatch[]

  @@unique([platform, externalId])
}

model Mismatch {
  id           String       @id @default(uuid())
  listingId    String
  listing      Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  field        String
  profileValue Json
  listingValue Json?
  kind         MismatchKind
  explanation  String?
  resolved     Boolean      @default(false)
  createdAt    DateTime     @default(now())

  proposals Proposal[]

  @@index([listingId])
  @@index([kind])
  @@index([resolved])
}

model Proposal {
  id         String         @id @default(uuid())
  mismatchId String
  mismatch   Mismatch       @relation(fields: [mismatchId], references: [id], onDelete: Cascade)
  platform   String
  field      String
  oldValue   Json?
  newValue   Json
  status     ProposalStatus @default(PENDING_APPROVAL)
  approvedAt DateTime?
  approvedBy String?
  rejectedAt DateTime?
  createdAt  DateTime       @default(now())

  updateResults UpdateResult[]
  verifications Verification[]

  @@index([status])
  @@index([mismatchId])
}

model UpdateResult {
  id         String        @id @default(uuid())
  proposalId String
  proposal   Proposal      @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  outcome    UpdateOutcome
  response   Json?
  createdAt  DateTime      @default(now())

  @@index([proposalId])
  @@index([outcome])
}

model Verification {
  id            String             @id @default(uuid())
  proposalId    String
  proposal      Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  observedValue Json?
  status        VerificationStatus @default(PENDING)
  checkedAt     DateTime           @default(now())

  @@index([proposalId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(uuid())
  eventType String
  actor     String   // "owner" | "agent" | "system"
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([eventType])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  role      UserRole @default(OPERATOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([role])
}

model Review {
  id               String   @id @default(uuid())
  authorName       String
  authorEmail      String?
  rating           Int      // 1 to 5 overall stars
  accuracyScore    Int      @default(5) // 1 to 5 rating on listing accuracy
  reliabilityScore Int      @default(5) // 1 to 5 rating on hours & contact reliability
  comment          String
  verified         Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([rating])
}

model PlatformReview {
  id                  String          @id @default(uuid())
  platform            String          // "mockMapsA" (Google Maps India) | "mockMapsB" (Mappls) | "mockDirectoryC" (Justdial)
  externalReviewId    String?
  authorName          String
  rating              Float           // 1.0 - 5.0
  reviewText          String
  reviewDate          DateTime        @default(now())
  sentiment           ReviewSentiment @default(NEUTRAL)
  responseStatus      ResponseStatus  @default(UNANSWERED)
  responseText        String?
  responseDraft       String?
  responseApproved    Boolean         @default(false)
  responsePublishedAt DateTime?
  suggestedAction     String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([platform])
  @@index([rating])
  @@index([sentiment])
  @@index([responseStatus])
}

model ReputationInsight {
  id                     String   @id @default(uuid())
  title                  String
  explanation            String
  category               String   // "Service Quality" | "Waiting Time" | "Hours Accuracy" | "Staff Behavior" | "Pricing"
  supportingReviewsCount Int
  reviewReferences       Json?
  recommendedAction      String
  confidence             Float    @default(0.92)
  createdAt              DateTime @default(now())

  @@index([createdAt])
}

model ReputationSettings {
  id                 String   @id @default("default-reputation-settings")
  lowRatingThreshold Float    @default(3.0)
  alertOnLowRating   Boolean  @default(true)
  alertOnUnanswered  Boolean  @default(true)
  updatedAt          DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  OPERATOR
  ADMIN
  VIEWER
}

enum ReviewSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum ResponseStatus {
  UNANSWERED
  ANSWERED
  DRAFT
  UNSUPPORTED
}

enum MismatchKind {
  MISSING
  OUTDATED
  CONFLICTING
  NEEDS_REVIEW
  OK
}

enum ProposalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum UpdateOutcome {
  SUCCESS
  FAILED
  BLOCKED
}

enum VerificationStatus {
  VERIFIED
  PENDING
  FAILED
  BLOCKED
}


